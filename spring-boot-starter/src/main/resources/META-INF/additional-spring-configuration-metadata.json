{
  "properties": [
    {
      "name": "cocache.spring-cache.retrieve-executor",
      "type": "java.lang.String",
      "description": "Deprecated since 6.3: Spring Cache retrieve uses the cache's async view and no executor; the value is ignored.",
      "deprecation": {
        "level": "warning",
        "reason": "Since 6.3 retrieve uses the async view and no executor; removed in 7.0."
      }
    },
    {
      "name": "cocache.redis.strict-failure",
      "type": "java.lang.Boolean",
      "description": "Removed in 6.0.",
      "deprecation": {
        "level": "error",
        "reason": "Removed in 6.0: L1 read failures are configured per cache.",
        "replacement": "cocache.defaults.read-failure"
      }
    },
    {
      "name": "cocache.redis.eviction-channel",
      "type": "java.lang.String",
      "description": "Removed in 6.0.",
      "deprecation": {
        "level": "error",
        "reason": "Removed in 6.0.",
        "replacement": "cocache.redis.channel-mode"
      }
    },
    {
      "name": "cocache.redis.missing-guard-sentinel",
      "type": "java.lang.String",
      "description": "Removed in 6.0.",
      "deprecation": {
        "level": "error",
        "reason": "Removed in 6.0 without replacement."
      }
    },
    {
      "name": "cocache.metrics.client-side-hits",
      "type": "java.lang.Boolean",
      "description": "Removed in 6.0.",
      "deprecation": {
        "level": "error",
        "reason": "Removed in 6.0.",
        "replacement": "cocache.metrics.local-hits"
      }
    },
    {
      "name": "cocache.load.max-concurrent",
      "type": "java.lang.Integer",
      "description": "Removed in 6.0.",
      "deprecation": {
        "level": "error",
        "reason": "Removed in 6.0.",
        "replacement": "cocache.defaults.load-max-concurrent"
      }
    },
    {
      "name": "cocache.load.acquire-timeout",
      "type": "java.time.Duration",
      "description": "Removed in 6.0.",
      "deprecation": {
        "level": "error",
        "reason": "Removed in 6.0.",
        "replacement": "cocache.defaults.load-acquire-timeout"
      }
    },
    {
      "name": "cocache.next.enabled",
      "type": "java.lang.Boolean",
      "description": "Removed in 6.0.",
      "deprecation": {
        "level": "error",
        "reason": "Removed in 6.0: the transitional prefix cocache.next.* became cocache.*.",
        "replacement": "cocache.enabled"
      }
    },
    {
      "name": "management.health.cocache.enabled",
      "type": "java.lang.Boolean",
      "description": "Whether to enable the CoCache health indicator (DOWN only when the invalidation channel heartbeat fails).",
      "defaultValue": true
    },
    {
      "name": "cocache.observation.enabled",
      "type": "java.lang.Boolean",
      "description": "Whether to record a Micrometer Observation (cocache.load) around each source load and lease wait. Needs micrometer-observation and an ObservationRegistry bean.",
      "defaultValue": true
    },
    {
      "name": "cocache.metrics.local-hits",
      "type": "java.lang.Boolean",
      "description": "Whether to count L2 hits (CacheMetrics.localHits, meter cocache.hits{level=l2}). Off by default: counting adds one LongAdder increment to every L2 hit.",
      "defaultValue": false
    }
  ],
  "hints": [
    {
      "name": "cocache.refresh-executor",
      "providers": [
        {
          "name": "spring-bean-reference",
          "parameters": {
            "target": "java.util.concurrent.Executor"
          }
        }
      ]
    },
    {
      "name": "cocache.spring-cache.retrieve-executor",
      "providers": [
        {
          "name": "spring-bean-reference",
          "parameters": {
            "target": "java.util.concurrent.Executor"
          }
        }
      ]
    },
    {
      "name": "cocache.backend",
      "values": [
        {
          "value": "redis",
          "description": "Redis backend built from Spring Data Redis connection details (default)."
        },
        {
          "value": "memory",
          "description": "In-process InMemoryBackend for local development and tests: single process only, no cross-instance coherence."
        }
      ]
    },
    {
      "name": "cocache.async-executor",
      "providers": [
        {
          "name": "spring-bean-reference",
          "parameters": {
            "target": "java.util.concurrent.Executor"
          }
        }
      ]
    },
    {
      "name": "cocache.blocking-executor",
      "providers": [
        {
          "name": "spring-bean-reference",
          "parameters": {
            "target": "java.util.concurrent.Executor"
          }
        }
      ]
    }
  ]
}
